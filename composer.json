{
    "name": "firebrikdotcom/conveyor-server-client",
    "description": "Server-Side WebSocket Client ready for Socket Conveyor",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Kanata\\ConveyorServerClient\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kanata\\ConveyorServerClient\\Tests\\": "tests"
        }
    },
    "require": {
        "php": "^8.3",
        "ext-openswoole": "^26.2",
        "textalk/websocket": "^1.6.3",
        "psr/log": "^3.0.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.4.6",
        "openswoole/ide-helper": "^26.2"
    },
    "scripts": {
        "test": [
            "sh scripts/test.sh"
        ],
        "coverage": [
            "sh scripts/test.sh --coverage-text --coverage-clover coverage.xml"
        ],
        "lint": [
            "find src tests -name \"*.php\" -print0 | xargs -0 -n1 php -l"
        ]
    },
    "archive": {
        "exclude": [
            "/tests",
            "/.github",
            "/composer.lock",
            "/phpunit.xml",
            "/coverage.xml",
            "/.cache",
            "/.phpunit.cache",
            "/task.json",
            "/review-findings.json",
            "/scripts",
            "/imgs/logo.svg",
            "/vendor",
            "/dist",
            "/.gitignore",
            "/.git"
        ]
    },
    "homepage": "https://github.com/firebrikdotcom/conveyor-server-client",
    "support": {
        "issues": "https://github.com/firebrikdotcom/conveyor-server-client/issues",
        "source": "https://github.com/firebrikdotcom/conveyor-server-client",
        "docs": "https://github.com/firebrikdotcom/conveyor-server-client#readme"
    }
}
